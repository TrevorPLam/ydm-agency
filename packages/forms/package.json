{
  "name": "@ydm-agency/forms",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage --passWithNoTests src --coverage.include \"src/**/*.{ts,tsx}\" --coverage.reportsDirectory coverage",
    "test:watch": "vitest src",
    "test:coverage": "vitest run --coverage --passWithNoTests src --coverage.include \"src/**/*.{ts,tsx}\" --coverage.reportsDirectory coverage",
    "format": "prettier --check ."
  },
  "dependencies": {
    "zod": "catalog:",
    "react": "catalog:",
    "@ydm-agency/ui": "workspace:*",
    "@ydm-agency/analytics": "workspace:*",
    "react-hook-form": "catalog:",
    "@hookform/resolvers": "catalog:"
  },
  "devDependencies": {
    "@ydm-agency/config": "workspace:*",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
