{
  "name": "@ydm-agency/utils",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage --passWithNoTests packages/utils/src --coverage.include \"packages/utils/src/**/*.{ts,tsx}\" --coverage.reportsDirectory packages/utils/coverage",
    "test:watch": "vitest packages/utils/src",
    "test:coverage": "vitest run --coverage --passWithNoTests packages/utils/src --coverage.include \"packages/utils/src/**/*.{ts,tsx}\" --coverage.reportsDirectory packages/utils/coverage"
  },
  "dependencies": {
    "clsx": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "devDependencies": {
    "@ydm-agency/config": "workspace:*",
    "typescript": "^5.6.0",
    "vitest": "catalog:"
  }
}
