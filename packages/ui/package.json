{
  "name": "@ydm-agency/ui",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage --passWithNoTests src --coverage.include \"src/**/*.{ts,tsx}\" --coverage.reportsDirectory coverage",
    "test:watch": "vitest src",
    "test:coverage": "vitest run --coverage --passWithNoTests src --coverage.include \"src/**/*.{ts,tsx}\" --coverage.reportsDirectory coverage"
  },
  "dependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "next": "catalog:",
    "lucide-react": "catalog:",
    "next-themes": "catalog:",
    "class-variance-authority": "catalog:",
    "@radix-ui/react-slot": "catalog:",
    "@radix-ui/react-dialog": "catalog:",
    "@radix-ui/react-dropdown-menu": "catalog:",
    "@ydm-agency/utils": "workspace:*"
  },
  "devDependencies": {
    "@ydm-agency/config": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.0",
    "vitest": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^25.0.0"
  }
}
