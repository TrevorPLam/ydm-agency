{
  "name": "@ydm-agency/ui",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage --passWithNoTests src --coverage.include \"src/**/*.{ts,tsx}\" --coverage.reportsDirectory coverage",
    "test:watch": "vitest src",
    "test:coverage": "vitest run --coverage --passWithNoTests src --coverage.include \"src/**/*.{ts,tsx}\" --coverage.reportsDirectory coverage",
    "format": "prettier --check ."
  },
  "dependencies": {
    "@radix-ui/react-dialog": "catalog:",
    "@radix-ui/react-dropdown-menu": "catalog:",
    "@radix-ui/react-slot": "catalog:",
    "@ydm-agency/utils": "workspace:*",
    "class-variance-authority": "catalog:",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^4.3.0",
    "@ydm-agency/config": "workspace:*",
    "jsdom": "^25.0.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
