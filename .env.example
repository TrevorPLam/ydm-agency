# YDM Agency - Environment Variables Configuration
# Copy this file to .env.local and fill in the actual values for your environment.
# Never commit .env.local or any file containing real API keys.

# ==============================================================================
# Analytics & Tracking
# ==============================================================================

# Google Analytics 4 Measurement ID
# Format: G-XXXXXXXXXX
# Source: https://analytics.google.com/ → Admin → Data Streams → Web → Stream Details → Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=your_ga_measurement_id_here

# PostHog Project API Key
# Format: phc_XXXXXXXXXX
# Source: https://app.posthog.com/project/settings → Project API Key
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key_here

# Meta Pixel ID (Facebook/Instagram)
# Format: XXXXXXXXXXXX
# Source: https://business.facebook.com/events_manager → Data Sources → Pixels → Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=your_meta_pixel_id_here

# ==============================================================================
# Email Service (Resend)
# ==============================================================================

# Resend API Key
# Format: re_XXXXXXXXXXXXXXXXXXXX
# Source: https://resend.com/api-keys → Create API Key → Send permissions
# NOTE: This is a server-only secret. Do NOT use NEXT_PUBLIC_ prefix.
RESEND_API_KEY=your_resend_api_key_here

# ==============================================================================
# Database (Supabase)
# ==============================================================================

# Supabase Project URL
# Format: https://xxxxxxxxxxxx.supabase.co
# Source: https://supabase.com/dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here

# Supabase Service Role Key
# Format: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Source: https://supabase.com/dashboard → Project Settings → API → service_role (secret)
# NOTE: This is a server-only secret. Do NOT use NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ==============================================================================
# Rate Limiting (Upstash Redis)
# ==============================================================================

# Upstash Redis REST URL
# Format: https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.upstash.io
# Source: https://upstash.com/console → Create Redis Database → REST API → REST URL
# NOTE: This is a server-only secret. Do NOT use NEXT_PUBLIC_ prefix.
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url_here

# Upstash Redis REST Token
# Format: AXUxXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Source: https://upstash.com/console → Create Redis Database → REST API → REST Token
# NOTE: This is a server-only secret. Do NOT use NEXT_PUBLIC_ prefix.
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# ==============================================================================
# Scheduling (Calendly)
# ==============================================================================

# Calendly Embed URL
# Format: https://calendly.com/username/event-type
# Source: https://calendly.com/event_types → Create event type → Share → Embed
NEXT_PUBLIC_CALENDLY_URL=your_calendly_embed_url_here
